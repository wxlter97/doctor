{
  "name": "medapoyo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @medapoyo/web dev",
    "build": "pnpm --filter @medapoyo/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "export:catalog": "tsx scripts/export-catalog.ts",
    "validate:catalog": "tsx scripts/export-catalog.ts --validate",
    "e2e": "pnpm --filter @medapoyo/web e2e",
    "review:packet": "tsx scripts/review-packet.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@medapoyo/shared": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0"
  }
}
